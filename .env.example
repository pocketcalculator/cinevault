# Copy to .env.local. Never commit real credentials.
# https://www.themoviedb.org/settings/api (API Read Access Token, not API key)
TMDB_READ_ACCESS_TOKEN=
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=cinevault
COSMOS_CONTAINER=movies
# Optional cover-photo identification. Use the base URL, not /responses.
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
